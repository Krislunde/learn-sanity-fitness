# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS
.DS_Store
**/.DS_Store

# Dependencies
/node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Staging ground for files fed to `sanity dataset import`. The dataset is the
# source of truth for content, so a copy in git would only compete with it and
# go stale the moment an editor changes something in the Studio.
/imported-data

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local
