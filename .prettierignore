# Nuxt recommends ESLint's stylistic rules as the formatter rather than Prettier,
# so `apps/web` is formatted by `@nuxt/eslint` (configured in its nuxt.config.ts)
# and Prettier stays out of it entirely. Running both would fight over Vue
# attribute wrapping, which is exactly the churn this split avoids.
apps/web/

# Vendored from sanity-io/agent-toolkit and hash-verified in skills-lock.json,
# so reformatting it would invalidate the recorded hash.
.agents/

# Generated, not hand-edited
apps/studio/schema.json
pnpm-lock.yaml

# Written by the Sanity CLI on every `blueprints deploy` (it restamps updatedAt),
# so formatting it just creates churn. Committed deliberately: it links this
# Blueprint to its Stack and holds no secrets.
/.sanity/

# Machine-local and git-ignored, so it never reaches CI - but Prettier walks the
# working tree rather than the index, so without this it fails `format:check`
# locally for whoever has one.
CLAUDE.md

# Git-ignored import staging ground. Prettier walks the working tree rather than
# the index, so without this it fails `format:check` locally for whoever has one -
# the same trap as CLAUDE.md above.
apps/studio/imported-data/

node_modules/
dist/
.nuxt/
.output/
